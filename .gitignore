# ---------------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------------
# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/

# Distribution / packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Local SQLite databases (seeded/generated at runtime)
*.db
*.sqlite
*.sqlite3
backend/prism.db

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/

# Vite / TypeScript incremental caches
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editor / OS / tooling
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Graphify tooling cache
.graphify/
